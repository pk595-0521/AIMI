DATABASE_URL="postgresql://aimi:change-me@localhost:5432/aimi?schema=public"
# Browser-safe Supabase values. Never put SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-or-anon-key"
APP_ORIGIN="http://localhost:3000"
PORT=3000
# OIDC gateway must set __Host-aimi_token (Secure; HttpOnly; SameSite=Strict; Path=/).
AUTH_JWKS_URL="https://identity.example.com/.well-known/jwks.json"
AUTH_ISSUER="https://identity.example.com/"
AUTH_AUDIENCE="aimi-superday"
# Comma-separated exact trusted reverse-proxy IPs; leave unset for direct access.
TRUSTED_PROXY_IPS=""
GEMINI_API_KEY=""
# Explicit deployment choice, not a user-supplied or invented model identifier.
GEMINI_MODEL=""
# Set only after verifying paid enterprise routing and the executed data agreement.
AI_ZERO_TRAINING_VERIFIED=false
AI_CONTRACT_REFERENCE=""
